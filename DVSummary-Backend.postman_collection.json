      "name": "2. status",
      "item": [
        {
          "name": "Database, Redis, vLLM과 Analysis Worker 전체 상태 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Health endpoint responds\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 503]); });",
                  "const response = pm.response.json();",
                  "pm.test(\"Database status is included\", function () { pm.expect(response.database.status).to.be.oneOf([\"ok\", \"unavailable\"]); });",
                  "pm.test(\"Redis status is included\", function () { pm.expect(response.cachedb.status).to.be.oneOf([\"ok\", \"unavailable\"]); });",
                  "pm.test(\"vLLM status is included\", function () { pm.expect(response.vllm.status).to.be.oneOf([\"ok\", \"unavailable\"]); });",
                  "pm.test(\"All active Analysis workers are included\", function () { pm.expect(response.analysis.worker_count).to.eql(response.analysis.workers.length); pm.expect(response.analysis.workers).to.be.an(\"array\"); });"
                ]
              }
            }
          ],
          "request": {
            "description": "PostgreSQL, Redis, vLLM 상태와 heartbeat TTL이 유효한 모든 Analysis worker 컨테이너 상태를 함께 조회합니다.",
            "method": "GET",
            "header": [],
            "url": "{{BASE_URL}}/status/health"
          },
          "response": []
        },
        {
          "name": "db health check",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
