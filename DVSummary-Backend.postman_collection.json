                      "pm.test(\"Server supports byte ranges\", function () { pm.expect(pm.response.headers.get(\"Accept-Ranges\")).to.eql(\"bytes\"); });",
                      "pm.test(\"Video data exists\", function () { pm.expect(pm.response.responseSize).to.be.above(0); });",
                      "pm.test(\"Content-Length matches response size\", function () { pm.expect(Number(pm.response.headers.get(\"Content-Length\"))).to.eql(pm.response.responseSize); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{BASE_URL}}/video/{{VIDEO_ID}}/stream"
              },
              "response": []
            },
            {
              "name": "8.2. Video 범위 스트리밍",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Partial video stream returned\", function () { pm.response.to.have.status(206); });",
                      "pm.test(\"Server supports byte ranges\", function () { pm.expect(pm.response.headers.get(\"Accept-Ranges\")).to.eql(\"bytes\"); });",
                      "pm.test(\"Requested range starts at zero\", function () { pm.expect(pm.response.headers.get(\"Content-Range\")).to.match(/^bytes 0-\\d+\\/\\d+$/); });",
                      "pm.test(\"Range data exists and length matches\", function () { pm.expect(pm.response.responseSize).to.be.above(0); pm.expect(Number(pm.response.headers.get(\"Content-Length\"))).to.eql(pm.response.responseSize); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Range",
                    "value": "bytes=0-1048575",
                    "type": "text"
                  }
                ],
                "url": "{{BASE_URL}}/video/{{VIDEO_ID}}/stream"
              },
              "response": []
            },
            {
              "name": "8.3. Video suffix 범위 스트리밍",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Suffix video stream returned\", function () { pm.response.to.have.status(206); });",
                      "pm.test(\"Server supports byte ranges\", function () { pm.expect(pm.response.headers.get(\"Accept-Ranges\")).to.eql(\"bytes\"); });",
                      "pm.test(\"Suffix range ends at the final byte\", function () { const match = pm.response.headers.get(\"Content-Range\").match(/^bytes (\\d+)-(\\d+)\\/(\\d+)$/); pm.expect(match).to.not.eql(null); pm.expect(Number(match[2])).to.eql(Number(match[3]) - 1); });",
                      "pm.test(\"Suffix data exists and length matches\", function () { pm.expect(pm.response.responseSize).to.be.above(0); pm.expect(Number(pm.response.headers.get(\"Content-Length\"))).to.eql(pm.response.responseSize); });"
                    ]
