    {
      "name": "4. Analysis Queue 검증",
      "description": "video_id를 기준으로 분석 작업을 큐에 등록하고 상태를 조회, 취소, 삭제하며 저장된 VLM 결과를 조회합니다. queued는 대기, running은 처리 중, succeeded는 완료, failed는 실패, cancelled는 취소 상태입니다.",
      "item": [
        {
          "name": "1. 분석 작업을 큐에 등록",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Analysis enqueued\", function () { pm.response.to.have.status(201); });",
                  "const response = pm.response.json();",
                  "pm.test(\"Analysis is queued for the requested video\", function () { pm.expect(response.video_id).to.eql(Number(pm.collectionVariables.get(\"VIDEO_ID_2\"))); pm.expect(response.status).to.eql(\"queued\"); });",
                  "pm.test(\"Internal analysis ID is hidden\", function () { pm.expect(response).to.not.have.property(\"id\"); });"
                ]
              }
            }
          ],
          "request": {
            "description": "POST /analysis: video_id의 영상을 분석 큐에 등록합니다. 성공하면 queued 상태가 되며 worker가 순서대로 처리합니다. 같은 영상에 취소되지 않은 작업이 있으면 409를 반환합니다.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": {{VIDEO_ID_2}},\n  \"settings\": {\n    \"model\": \"anomaly-v1\",\n    \"threshold\": 0.7\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{BASE_URL}}/analysis"
          },
          "response": []
        },
        {
          "name": "2. 전체 분석 큐 작업 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"All analyses returned\", function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.test(\"Response is an analysis list\", function () { pm.expect(response).to.be.an(\"array\"); pm.expect(response.some((analysis) => analysis.video_id === Number(pm.collectionVariables.get(\"VIDEO_ID_2\")))).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "description": "GET /analysis: 분석 큐의 모든 작업과 현재 상태를 최신순으로 조회합니다.",
            "method": "GET",
            "header": [],
            "url": "{{BASE_URL}}/analysis"
          },
          "response": []
        },
        {
          "name": "3. video_id로 분석 큐 작업 목록 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Video analyses returned\", function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.test(\"Every analysis belongs to the video\", function () { pm.expect(response).to.be.an(\"array\"); pm.expect(response.every((analysis) => analysis.video_id === Number(pm.collectionVariables.get(\"VIDEO_ID_2\")))).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "description": "GET /analysis?video_id=...: 지정한 영상에 등록된 분석 큐 작업만 조회합니다.",
            "method": "GET",
            "header": [],
            "url": "{{BASE_URL}}/analysis?video_id={{VIDEO_ID_2}}"
          },
          "response": []
        },
        {
          "name": "4. 상태별 분석 큐 작업 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Queued analyses returned\", function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.test(\"Every analysis is queued\", function () { pm.expect(response).to.be.an(\"array\"); pm.expect(response.every((analysis) => analysis.status === \"queued\")).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "description": "GET /analysis?status=...: queued, running, succeeded, failed, cancelled 상태로 큐 작업을 필터링합니다.",
            "method": "GET",
            "header": [],
            "url": "{{BASE_URL}}/analysis?status=queued"
          },
          "response": []
        },
        {
          "name": "5. 분석 큐 작업 페이지 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Paginated analyses returned\", function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.test(\"Limit is applied\", function () { pm.expect(response).to.be.an(\"array\"); pm.expect(response.length).to.be.at.most(1); });"
                ]
              }
            }
          ],
          "request": {
            "description": "GET /analysis?limit=...&offset=...: limit과 offset으로 분석 큐 목록을 나누어 조회합니다.",
            "method": "GET",
            "header": [],
            "url": "{{BASE_URL}}/analysis?limit=1&offset=0"
          },
          "response": []
        },
        {
          "name": "6. 중복 큐 등록 거부 확인",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Duplicate analysis rejected\", function () { pm.response.to.have.status(409); });",
                  "const response = pm.response.json();",
                  "pm.test(\"Current analysis state returned\", function () { pm.expect(response.video_id).to.eql(Number(pm.collectionVariables.get(\"VIDEO_ID_2\"))); pm.expect(response.status).to.eql(\"queued\"); });"
                ]
              }
            }
          ],
          "request": {
            "description": "같은 영상에 취소되지 않은 분석 작업이 이미 있을 때 새 큐 작업을 만들지 않고 409를 반환하는지 확인합니다.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": {{VIDEO_ID_2}},\n  \"settings\": {\n    \"model\": \"anomaly-v1\",\n    \"threshold\": 0.8\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{BASE_URL}}/analysis"
          },
          "response": []
        },
        {
          "name": "7. 영상의 최신 분석 큐 작업 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Analysis returned\", function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.test(\"Correct video analysis returned\", function () { pm.expect(response.video_id).to.eql(Number(pm.collectionVariables.get(\"VIDEO_ID_2\"))); pm.expect(response).to.not.have.property(\"id\"); });"
                ]
              }
            }
          ],
          "request": {
            "description": "GET /analysis/{video_id}: 해당 영상에 가장 최근에 등록된 큐 작업의 상태, 처리 시각, 오류 정보를 조회합니다.",
            "method": "GET",
            "header": [],
            "url": "{{BASE_URL}}/analysis/{{VIDEO_ID_2}}"
          },
          "response": []
        },
        {
          "name": "8. 영상의 VLM 분석 결과 전체 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Result endpoint responds according to availability\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });",
                  "const response = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "  pm.test(\"Correct video result returned\", function () { pm.expect(response.video_id).to.eql(Number(pm.collectionVariables.get(\"VIDEO_ID_2\"))); });",
                  "  pm.test(\"Result response has metadata and VLM results\", function () { pm.expect(response).to.have.property(\"metadata\"); pm.expect(response.results).to.be.an(\"array\"); });",
                  "  pm.test(\"VLM responses are parsed JSON values\", function () { response.results.forEach((result) => pm.expect(result.response).to.satisfy((value) => typeof value === \"object\" && value !== null)); });",
                  "  if (response.status !== \"succeeded\") {",
                  "    pm.test(\"Incomplete analysis includes warning\", function () { pm.expect(response.warning).to.be.a(\"string\").and.not.empty; });",
                  "  }",
                  "} else {",
                  "  pm.test(\"Unavailable result returns detail\", function () { pm.expect(response.detail).to.be.a(\"string\").and.not.empty; });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "description": "GET /analysis/result/{video_id}/all: 분석 컨테이너를 거치지 않고 SQLite에서 VLM 결과를 직접 조회합니다. 분석 미완료 상태라도 데이터가 있으면 warning과 함께 반환합니다.",
            "method": "GET",
            "header": [],
            "url": "{{BASE_URL}}/analysis/result/{{VIDEO_ID_2}}/all"
          },
          "response": []
        },
        {
          "name": "9. 대기 또는 실행 중인 큐 작업 취소",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Analysis cancelled\", function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.test(\"Analysis status is cancelled\", function () { pm.expect(response.video_id).to.eql(Number(pm.collectionVariables.get(\"VIDEO_ID_2\"))); pm.expect(response.status).to.eql(\"cancelled\"); });"
                ]
              }
            }
          ],
          "request": {
            "description": "POST /analysis/{video_id}/cancel: 최신 큐 작업이 queued 또는 running이면 cancelled로 변경합니다. 레코드는 삭제하지 않습니다.",
            "method": "POST",
            "header": [],
            "url": "{{BASE_URL}}/analysis/{{VIDEO_ID_2}}/cancel"
          },
          "response": []
        },
        {
          "name": "10. 취소된 영상 분석을 다시 큐에 등록",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Cancelled analysis re-enqueued\", function () { pm.response.to.have.status(201); });",
                  "const response = pm.response.json();",
                  "pm.test(\"A new queued analysis was created\", function () { pm.expect(response.video_id).to.eql(Number(pm.collectionVariables.get(\"VIDEO_ID_2\"))); pm.expect(response.status).to.eql(\"queued\"); });"
                ]
              }
            }
          ],
          "request": {
            "description": "취소된 작업이 있는 영상을 다시 분석 큐에 등록해 새로운 queued 작업을 생성합니다.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": {{VIDEO_ID_2}},\n  \"settings\": {\n    \"model\": \"anomaly-v1\",\n    \"threshold\": 0.9\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{BASE_URL}}/analysis"
          },
          "response": []
        },
        {
          "name": "11. 최신 분석 작업을 큐에서 삭제",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Analysis deleted\", function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.test(\"Correct analysis was deleted\", function () { pm.expect(response.deleted).to.eql(true); pm.expect(response.video_id).to.eql(Number(pm.collectionVariables.get(\"VIDEO_ID_2\"))); });"
                ]
              }
            }
          ],
          "request": {
            "description": "DELETE /analysis/{video_id}: 최신 분석 큐 레코드를 영구 삭제하고 영상 분석 상태를 pending으로 되돌립니다. SQLite 결과 파일은 삭제하지 않습니다.",
            "method": "DELETE",
            "header": [],
            "url": "{{BASE_URL}}/analysis/{{VIDEO_ID_2}}"
          },
          "response": []
        },
        {
          "name": "12. 삭제된 큐 작업 조회 실패 확인",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Deleted analysis is not found\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Not-found detail returned\", function () { pm.expect(pm.response.json().detail).to.eql(\"Analysis job not found\"); });"
                ]
              }
            }
          ],
          "request": {
            "description": "큐에서 삭제한 영상의 최신 분석 작업을 다시 조회했을 때 404를 반환하는지 확인합니다.",
            "method": "GET",
            "header": [],
            "url": "{{BASE_URL}}/analysis/{{VIDEO_ID_2}}"
          },
          "response": []
        },
        {
          "name": "13. 잘못된 큐 상태 필터 거부 확인",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Invalid status rejected\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Validation detail returned\", function () { pm.expect(pm.response.json().detail).to.include(\"Unsupported analysis status\"); });"
                ]
              }
            }
          ],
          "request": {
            "description": "지원하지 않는 status 값을 전달했을 때 400을 반환하는지 확인합니다.",
            "method": "GET",
            "header": [],
            "url": "{{BASE_URL}}/analysis?status=invalid"
          },
          "response": []
        },
        {
          "name": "14. 존재하지 않는 영상의 큐 등록 거부 확인",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Missing video rejected\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Video not-found detail returned\", function () { pm.expect(pm.response.json().detail).to.eql(\"Video not found\"); });"
                ]
              }
            }
          ],
          "request": {
            "description": "존재하지 않는 video_id를 분석 큐에 등록하려 할 때 404를 반환하는지 확인합니다.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_id\": 999999999,\n  \"settings\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{BASE_URL}}/analysis"
          },
          "response": []
        }
      ]
