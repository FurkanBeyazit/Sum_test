    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedErrorStatuses = {",
          "  \"6. 중복 큐 등록 거부 확인\": [409],",
          "  \"8. 영상의 VLM 분석 결과 전체 조회\": [200, 404],",
          "  \"12. 삭제된 큐 작업 조회 실패 확인\": [404],",
          "  \"13. 잘못된 큐 상태 필터 거부 확인\": [400],",
          "  \"14. 존재하지 않는 영상의 큐 등록 거부 확인\": [404]",
          "};",
          "",
          "const expectedStatuses = expectedErrorStatuses[pm.info.requestName];",
          "pm.test(`[전체 API] ${pm.info.requestName} 응답 상태 정상`, function () {",
          "  if (expectedStatuses) {",
          "    pm.expect(pm.response.code).to.be.oneOf(expectedStatuses);",
          "    return;",
          "  }",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});"
        ]
      }
    }
  ],
